{
  "name": "facebook-chatbot-app",
  "version": "1.0.0",
  "description": "Facebook Chatbot Manager - Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "Facebook Chatbot App",
  "license": "MIT",
  "dependencies": {
    "electron": "^28.0.0",
    "express": "^4.18.2",
    "node-fetch": "^2.7.0",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.facebook.chatbot",
    "productName": "Facebook Chatbot Manager",
    "win": {
      "target": "nsis",
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
